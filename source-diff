(define (import-info meta source-cell*)

  (define sfd-sig
    (let ([ht (make-eq-hashtable)])
      (lambda (sfd)
        (or (eq-hashtable-ref ht sfd #f)
            (let ([x (cons (source-file-descriptor-checksum sfd)
                       (sfd-source-path sfd get-real-path))])
              (eq-hashtable-set! ht sfd x)
              x)))))

  (define (sfd-sig-hash sfd) (equal-hash (sfd-sig sfd)))
  (define (sfd-sig=? x y)
    (or (eq? x y)
        (equal? (sfd-sig x) (sfd-sig y))))
  (define (sfd-source-path sfd convert)
    (let ([ip (open-source-file sfd)])
      (if ip
          (on-exit (close-port ip)
            (convert (port-name ip)))
          (source-file-descriptor-path sfd))))

  (define (load-code abs-filename checksum)
    (and (file-exists? abs-filename)
         (match (try (read-file abs-filename))
           [`(catch ,reason)
            (printf "  ~a: ~a\n" abs-filename (exit-reason->english reason))
            #f]
           [,code
            (let* ([sfd (make-source-file-descriptor abs-filename (open-bytevector-input-port code))]
                   [update? (eqv? (source-file-descriptor-checksum sfd) checksum)])
              (cond
               [update? code]
               [else
                (printf "  ~a: mismatched checksums\n" abs-filename)
                (printf "    ~s vs ~s\n" (source-file-descriptor-checksum sfd) checksum)
                (printf "    ~s\n" (source-file-descriptor-path sfd))
                (printf "    ~s\n" abs-filename)
                #f]))])))

  (define sfd-table (make-hashtable sfd-sig-hash sfd-sig=?))

  (for-each
   (lambda (p)
     (let* ([so (car p)]
            [sfd (source-object-sfd so)])
       (hashtable-set! sfd-table sfd (source-file-descriptor-checksum sfd))))
   source-cell*)
  (vector-for-each
   (lambda (p)
     (match p
       [(,orig-filename ,abs-filename ,checksum)
        (db:log 'db
          (ct:join " "
            "insert or ignore into stage_file"
            "(original_filename,absolute_filename,checksum,code)"
            "values (?,?,?,?)")
          orig-filename
          abs-filename
          checksum
          (load-code abs-filename checksum))]))
   (let-values ([(keys vals) (hashtable-entries sfd-table)])
     (vector-map
      (lambda (sfd cs)
        (list (source-file-descriptor-path sfd)
          (sfd-source-path sfd values)
          cs))
      keys vals)))

  (let ([meta (json:object->string meta)])
    (for-each
     (lambda (p)
       (let* ([so (car p)]
              [info (cdr p)]
              [sfd (source-object-sfd so)])
         (db:log 'db
           (ct:join " "
             "insert into stage_profile"
             "(meta,checksum,bfp,efp,info)"
             "values (?,?,?,?,json(?))")
           meta
           (source-file-descriptor-checksum sfd)
           (source-object-bfp so)
           (source-object-efp so)
           (json:object->string info))))
     source-cell*)))

(define-syntax foreach
  (syntax-rules ()
    [(_ ([var collection*] ...) e0 e1 ...)
     (let ([f (lambda (var ...) e0 e1 ...)]
           [var collection*] ...)
       (cond
        [(and (vector? var) ...) (vector-for-each f var ...)]
        [else (for-each f var ...)]))]))

(define (build-database merge? import! meta)
  (define (bool->db x)
    (if x 1 0))
  (match-let* ([#(ok ,pid) (db:start&link 'db db-file 'create)])
    (unlink pid)
    (on-exit (db:stop pid)
      (transaction 'db
        (execute "drop table if exists stage_profile")
        (create-table stage_profile
          [meta text]
          [checksum integer]
          [bfp integer]
          [efp integer]
          [info text])

        (execute "drop table if exists stage_file")
        (create-table stage_file
          [original_filename text]
          [absolute_filename text]
          [checksum integer unique]
          [code text]              ; TODO: We might prefer a blob here
          )

        (execute "drop table if exists stage_token")
        (create-table stage_token
          [src_fk integer]
          [type text]
          [value text]
          [raw text]
          [bfp integer]
          [efp integer]
          [err text]
          [prop_number integer]
          [prop_char integer]
          [prop_string integer]
          [prop_comment integer])

        (unless merge?
          (execute "drop table if exists dim_observation")
          (create-table dim_observation
            [obs_pk integer primary key]
            [obs_meta text])

          (execute "drop table if exists dim_range")
          (create-table dim_range
            [rng_pk integer primary key]
            [rng_bfp integer]
            [rng_efp integer])

          (execute "drop table if exists dim_source")
          (create-table dim_source
            [src_pk integer primary key]
            [src_filename text]
            [src_checksum integer unique]
            [src_code text]        ; TODO: We might prefer a blob here
            [src_has_code integer "generated always as (case when src_code is null then 0 else 1 end) stored"]
            )

          (execute "drop table if exists dim_token")
          (create-table dim_token
            [tok_pk integer primary key]
            [tok_type text]
            [tok_value text]
            [tok_raw text]
            [tok_err text]
            [tok_prop_number integer]
            [tok_prop_char integer]
            [tok_prop_string integer]
            [tok_prop_comment integer])

          (execute "drop table if exists fact_profile")
          (create-table fact_profile
            [obs_fk integer]
            [src_fk integer]
            [rng_fk integer]
            [info text])

          (execute "drop table if exists fact_tokens")
          (create-table fact_tokens
            [src_fk integer]
            [tok_fk integer]
            [rng_fk integer])
          ))

      (import! meta)

      (transaction 'db
        (execute
         (ct:join " "
           "insert into dim_observation (obs_meta)"
           "select distinct meta from stage_profile"
           "except select obs_meta from dim_observation"))
        (execute
         (ct:join " "
           "insert into dim_range (rng_bfp,rng_efp)"
           "select distinct bfp,efp from stage_profile"
           "except select rng_bfp,rng_efp from dim_range"))
        (execute
         (ct:join " "
           "insert or ignore into dim_source (src_filename,src_checksum,src_code)"
           "select distinct original_filename,checksum,code from stage_file"
           "except select src_filename,src_checksum,src_code from dim_source"))
        (execute
         (ct:join " "
           "insert into fact_profile"
           "(obs_fk, src_fk, rng_fk, info)"
           "select obs_pk, src_pk, rng_pk, info"
           "from stage_profile"
           "inner join dim_observation on meta=obs_meta"
           "inner join dim_source on checksum=src_checksum"
           "inner join dim_range on bfp=rng_bfp and efp=rng_efp")))

      (time
       (begin
         (for-each
          (lambda (row)
            (match row
              [#(,src ,fn ,code)
               (when code
                 (match (try (tokenize (utf8->string code)))
                   [`(catch ,reason)
                    (printf "  ~a: ~a\n" fn (exit-reason->english reason))]
                   [,tokens
                    (for-each
                     (lambda (t)
                       (db:log 'db
                         (ct:join " "
                           "insert into stage_token"
                           "(src_fk,type,value,raw,bfp,efp,err,prop_number,prop_char,prop_string,prop_comment)"
                           "values (?,?,?,?,?,?,?,?,?,?,?)")
                         src
                         (coerce (token-type t))
                         (coerce (token-value t))
                         (coerce (token-raw t))
                         (token-bfp t)
                         (token-efp t)
                         (coerce (token-err t))
                         (bool->db (has-prop? t 'number))
                         (bool->db (has-prop? t 'char))
                         (bool->db (has-prop? t 'string))
                         (bool->db (has-prop? t 'comment))))
                     tokens)]))]))
          (transaction 'db
            (execute
             (ct:join " "
               "select src_pk, src_filename, src_code"
               "from dim_source"
               "where src_code is not null"
               "and src_pk not in (select distinct src_fk from fact_tokens)"))))

         (transaction 'db
           (execute
            (ct:join " "
              "insert into dim_token (tok_type,tok_value,tok_raw,tok_err,tok_prop_number,tok_prop_char,tok_prop_string,tok_prop_comment)"
              "select distinct type,value,raw,err,prop_number,prop_char,prop_string,prop_comment from stage_token"
              "except select tok_type,tok_value,tok_raw,tok_err,tok_prop_number,tok_prop_char,tok_prop_string,tok_prop_comment from dim_token"))
           (execute
            (ct:join " "
              "insert into dim_range (rng_bfp,rng_efp)"
              "select distinct bfp,efp from stage_token"
              "except select rng_bfp,rng_efp from dim_range"))
           ;; TODO: is it possible it's enough to join on 'raw'
           ;; and 'err' for tokens?

           ;; N.B. "value is tok_value" and "err is tok_err"
           ;; may be necessary because value and err can be
           ;; NULL.
           (execute
            (ct:join " "
              "insert into fact_tokens"
              "(src_fk, tok_fk, rng_fk)"
              "select src_fk, tok_pk, rng_pk"
              "from stage_token"
              "inner join dim_token on type=tok_type and value is tok_value and raw=tok_raw and err is tok_err and prop_number=tok_prop_number and prop_char=tok_prop_char and prop_string=tok_prop_string and prop_comment=tok_prop_comment"
              "inner join dim_range on bfp=rng_bfp and efp=rng_efp")))
         ))

      (transaction 'db
        (define (create-index name sql)
          (execute (format "create index if not exists ~a on ~a" name sql)))
        (create-index 'dim_rng_bfp "dim_range (rng_bfp)")
        (create-index 'dim_rng_efp "dim_range (rng_efp)")

        (create-index 'fa_pr_obs "fact_profile (obs_fk)")
        (create-index 'fa_pr_rng "fact_profile (rng_fk)")
        (create-index 'fa_pr_src_rng "fact_profile (src_fk,rng_fk)")

        (create-index 'fa_to_rng "fact_tokens (rng_fk)")
        (create-index 'fa_to_src "fact_tokens (src_fk)")
        (create-index 'fa_to_tok "fact_tokens (tok_fk)")
        )

      (transaction 'db
        (execute "drop table stage_profile")
        (execute "drop table stage_file")
        (execute "drop table stage_token"))
      )))

(define (sfd->json sfd)
  (json:make-object
   [crc (source-file-descriptor-checksum sfd)]
   [path (source-file-descriptor-path sfd)]))

(define (maybe-source->json x)
  (cond
   [(source-object? x)
    (json:make-object
     [bfp (source-object-bfp x)]
     [efp (source-object-efp x)]
     [sfd (sfd->json (source-object-sfd x))])]
   [(not x) #f]
   [else (json:make-object [not-source (format "~s" x)])]))

(define (get-source x) (and (annotation? x) (annotation-source x)))

(cond
 [(opt 'help)
  (display-help (app:name) cli (opt))
  (exit 0)])

(cond
 [(opt 'srcdirs) =>
  (lambda (srcdirs)
    (source-directories (append srcdirs (source-directories))))])

(cond
 [(opt 'import) =>
  (lambda (filename)
    (time
     (match-let*
      ([#(<sm> ,st-dump ,prim* ,node* ,rubbish)
        (let ([ip (open-binary-file-to-read filename)])
          (on-exit (close-port ip)
            (fasl-read ip)))])
      ;; HACK in an adapter
      (define st (make-source-table))
      (define (add-source-info! src info)
        (when (source-object? src)
          (let ([cell (source-table-cell st src '())])
            (set-cdr! cell (cons info (cdr cell))))))
      (define (add-edge edge-json)
        ;; shared structure here may be hooey; we probably don't leverage it yet
        (lambda (use)
          (and use
               (let ([use-src
                      (cond
                       [(or (source-object? use) (annotation? use)) use]
                       [(identifier-info? use) (identifier-info-def use)]
                       [(interface-info? use) (interface-info-def use)]
                       [else (errorf #f "can't determine use-src from ~s\n" use)])])
                 (add-source-info! use-src edge-json)))))
      ;; TODO important(?) this will get the wrong answer if we use (import (except (foo) bar)) and also use (import (foo))
      ;;      --> it's "wrong" because we currently get the import source for the entire import spec
      ;;      - maybe add-import! should also give us the source for the specific library/module import
      ;;      - that is, we might want the UI to show us:
      ;;        1. only what is imported by that specific import-spec, and / or
      ;;           - in this case, we'd need to track more precise information in add-import!
      ;;        2. everything we imported from that library (that's probably the case I'd use most)
      ;;           - in this case, we may get mileage out of a database query
      (define (add-show-imported-query client-src)
        (lambda (import-src)
          (add-source-info! import-src
            (json:make-object [show_imported (maybe-source->json client-src)]))))
      (define (json-sanitize name)
        (format "~a"
          (if (annotation? name)
              (annotation-stripped name)
              name)))
      (foreach ([node node*])
        (cond
         [(identifier-info? node) ;; TODO oh boy
          ;; BARF not even close to what we actually want
          (let* ([def (identifier-info-def node)]
                 [kind (symbol->string (identifier-info-kind node))]
                 [name (json-sanitize (identifier-info-name node))]
                 [json
                  ;; double down on shared-structure hooey
                  ;; in theory, Chris will replace all of this with something that does
                  ;; the db inserts directly
                  (json:make-object
                   [kind kind]
                   [name name]
                   [refs (map maybe-source->json (identifier-info-ref* node))]
                   [sets (map maybe-source->json (identifier-info-set* node))])]
                 [def-json
                  (json:make-object
                   [kind kind]
                   [name name]
                   [def (maybe-source->json def)])])
            (for-each (add-edge def-json) (identifier-info-ref* node))
            (for-each (add-edge def-json) (identifier-info-set* node))
            (when (eq? 'global (identifier-info-kind node))
              (for-each (add-edge json) (identifier-info-set* node))
              (let ([set-json
                     (json:make-object
                      [kind kind]
                      [name name]
                      [sets (map maybe-source->json (identifier-info-set* node))])])
                (for-each (add-edge set-json) (identifier-info-ref* node))))
            (when def (add-source-info! def json)))]
         [(interface-info? node)
          (let* ([src (interface-info-src node)]                ;; e.g., source for entire library
                 [def (get-source (interface-info-name node))]  ;; e.g., source for library name
                 [kind (symbol->string (interface-info-kind node))]
                 [name (json-sanitize (interface-info-name node))]
                 [def-json
                   (json:make-object
                    [kind kind]
                    [name name]
                    [def (maybe-source->json def)])])
            (for-each (add-edge def-json) (interface-info-ref* node))
            (for-each (add-show-imported-query src) (interface-info-ref* node))
            ;; TODO what should we do with interface-info-impreq*
            ;; TODO what should we do with interface-info-export*
            ;;      - maybe it was enough that we added the global-ref at the export point?
            (when (or def src)
              ;; TODO consider using source for the library name / module name here [needs update to s/syntax.ss]
              (add-source-info! (or def src)
                (json:make-object
                 [kind kind]
                 [name name]
                 [refs (map maybe-source->json (interface-info-ref* node))]
              ;; [realm-src (maybe-source->json src)]
                 [exports
                  (map
                   (lambda (x)
                     (cond
                      [(identifier-info? x)
                       (json:make-object
                        [export (json-sanitize (identifier-info-name x))]
                        [kind (json-sanitize (identifier-info-kind x))]
                        [src (maybe-source->json (identifier-info-def x))])]
                      [(interface-info? x)
                       (json:make-object
                        [export (json-sanitize (interface-info-name x))]
                        [kind (json-sanitize (interface-info-kind x))]
                        [src (maybe-source->json (interface-info-src x))])]
                      [else
                       (json:make-object
                        [export "??? unknown ???"])]))
                   (interface-info-export* node))]
                 [src (maybe-source->json src)]
                 ))))]
         [else (printf "some other node: ~s\n" node)]))
      (foreach ([prim prim*])
        ;; prep.ss flipped these to the form below
        (match prim
          [(,name [safe ,safe-src*] [unsafe ,unsafe-src*])
           (let* ([name (symbol->string name)]
                  [safe (json:make-object [prim name] [mode "safe"])]
                  [unsafe (json:make-object [prim name] [mode "unsafe"])])
             (foreach ([src safe-src*]) (add-source-info! src safe))
             (foreach ([src unsafe-src*]) (add-source-info! src unsafe)))]))
      (printf "made it here ===================\n")
      (build-database (opt 'merge)
        ;; TODO fix goofy interface; trying to not change much code right now
        (lambda (meta)
          (import-info meta (source-table-dump st)))
        (json:make-object
         [filename filename]
         [note (opt 'note)]))))
    (exit 0))])

(define (scalar x)
  (match x
    [(#(,v)) v]
    [() #f]))

(let ()
  (define (arg->integer s)
    (define (parse s i n v)
      (if (= i n)
          v
          (let ([d (- (char->integer (string-ref s i)) (char->integer #\0))])
            (and (<= 0 d 9)
                 (parse s (+ i 1) n (+ (* v 10) d))))))
    (let ([n (string-length s)])
      (and (<= 1 n 13)
           (if (char=? (string-ref s 0) #\-)
               (- (parse s 1 n 0))
               (parse s 0 n 0)))))
  (define (not-found conn)
    (http:respond conn 404 '()
      (html->bytevector
       `(html5
         (head
          (meta (@ (charset "UTF-8")))
          (title "Page not found"))
         (body
          (h1 "Nothing to see here. Move along."))))))
  (define (obs->list x)
    (cond
     [(not x) '()]
     [(not (string? x)) (bad-arg 'obs->list x)]
     [(string=? x "") '()]
     [else
      (let ([ls (map arg->integer (split x #\,))])
        (when (ormap not ls)
          (bad-arg 'obs->list x))
        ls)]))
  (define (template ls)
    (join (map (lambda (x) "?") ls) #\,))

  (define (link anchor base-url src obs-list cm)
    (let* ([args '()]
           [args (if cm
                     (cons (cons 'cm cm) args)
                     args)]
           [args (if (pair? obs-list)
                     (cons (cons 'obs (join obs-list #\,)) args)
                     args)]
           [args (if src
                     (cons (cons 'src src) args)
                     args)]
           [url (format "~a~:[?~a~;~]" base-url
                  (null? args)
                  (if (null? args)
                      ""
                      (join
                       (map
                        (lambda (arg)
                          (format "~a=~a" (car arg) (cdr arg)))
                        args)
                       #\&)))])
      `(a (@ (href ,url)) ,anchor)))

  (define (navigation-panel base-url src obs cm)
    `(header (@ (class "navigation"))
      ,(link "files" "/files" #f obs cm)
      ,@(map
         (lambda (row)
           (match row
             [#(,pk ,note)
              `(div
                ;; Heavy check marks and non-breaking spaces ahead.
                ,(if (memv pk obs)
                     (format "~c~c" (integer->char #x2714)(integer->char #x00A0))
                     (format "~c~c" (integer->char #x00A0) (integer->char #x00A0)))
                ,(link note base-url src
                   (if (memv pk obs)
                       (remv pk obs)
                       (sort < (cons pk obs)))
                   cm))]))
         (transaction 'db
           (execute
            (ct:join " "
              "select obs_pk, json_extract(obs_meta, '$.note')"
              "from dim_observation"))))
       (hr)))

  (define-syntax (extract-block-comment x) ;; NOTE: slightly modified here
    (let ([annotation (syntax->annotation x)])
      (assert annotation)
      (let* ([src (annotation-source annotation)]
             [bfp (source-object-bfp src)]
             [efp (source-object-efp src)]
             [path (source-file-descriptor-path (source-object-sfd src))])
        #`(begin ;; lambda ()
            (let ([s (utf8->string (read-file #,path))])
              (define (scan i dir prev)
                (let ([c (string-ref s i)] [next (+ i dir)])
                  (unless (< 0 next #,efp)
                    (errorf 'extract-block-comment "expected to find #| ... |# in ~a" s))
                  (if (and (char=? c #\|) (eqv? prev #\#))
                      next
                      (scan next dir c))))
              (substring s (scan #,bfp 1 #f) (scan #,efp -1 #f)))))))

  (define animation-duration 1500) ;; BARF

  (define (render-source conn src obs cm target-bfp)
    (match (transaction 'db
             (execute "select src_filename, src_code, src_checksum from dim_source where src_pk=?" src))
      [() (not-found conn)]
      [(#(,filename ,code, checksum))
       ;; Fancy
       (define ip (open-bytevector-input-port code (make-utf8-transcoder)))
       (define data
         (transaction 'db
           (apply execute
             (format
              (ct:join " "
                "select distinct rng_bfp, rng_efp, info"
                "from fact_profile"
                "inner join dim_range on rng_pk=rng_fk"
                "where src_fk=?"
                "and obs_fk in (~a)"
                "group by rng_bfp, rng_efp"
                "order by rng_bfp")
              (template obs))
             src
             obs)))
       (define (get-bfp row) (vector-ref row 0))
       (define (get-efp row) (vector-ref row 1))
       (define (get-info row) (json:string->object (vector-ref row 2)))
       (define-values (op get) (open-bytevector-output-port (make-utf8-transcoder)))

       (fprintf op
         (ct:join #\newline
           "<!DOCTYPE html>"
           "<html>"
           "<head>"
           "<meta charset=\"UTF-8\">"
           "<title>~a</title>"
           "<link type=\"text/css\" rel=\"stylesheet\" href=\"style.css?cm=~a\">"
           ;; TODO this is clearly not the way to include scripts
           "<script>"
           "var infoDictionary = {};"
           (format "const myFilename = '~a';" filename)
           (format "const myChecksum = '~a';" checksum)
           (format "const myObs = '~{~a~^,~}';" obs)
           (format "const mySrc = '~a';" src)
           (format "const myTargetBFP = 'bfp~a';" target-bfp)
           (format "const animationDuration = ~f;" animation-duration)
           (extract-block-comment #|
                  function encodeHtml(str) {
                    if (!str) return str;
                    return str.replace(/&/g, '&amp;')
                              .replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;')
                              .replace(/'/g, '&#039;');
                  }
                  function showSource(field) {
                    return src => {
                      if (!src) return;
                      if (!src.bfp) return;
                      if (src.sfd.crc != myChecksum && src.sfd.path != myFilename) return; // handled by links in legend
