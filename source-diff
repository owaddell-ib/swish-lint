           (fprintf op ".cov_low { color: #FF0000; }\n")
           (fprintf op ".cov_medium { color: #FF8800; }\n")
           (fprintf op ".cov_high { color: #007F00; }\n")
           (fprintf op ".ws { background-color: ~a; }\n" bg))
         #;     
         (match cm
           ["default"
            ;; 0=gray, red .. yellow
            (output-color-class 0 .75 .75 .75)
            (output-gradient op 1 128 1.0 0.5 0.5 1.0 1.0 0.5)]
           ["green"
            ;; 0=gray, dark green .. bright green
            (output-color-class 0 .75 .75 .75)
            (output-gradient op 1 128 0.25 0.5 0.25 0.5 1.0 0.5)]
           ["blue"
            ;; 0=gray, blue .. yellow
            (output-color-class 0 .75 .75 .75)
            (output-gradient op 1 128 0.25 0.5 1.0 1.0 1.0 0.5)]
           ["purple"
            ;; 0=gray, purple .. yellow
            (output-color-class 0 .75 .75 .75)
            (output-gradient op 1 128 0.75 0.25 0.75 1.0 1.0 0.5)]
           ["zero"
            ;; 0=red only
            (output-color-class 0 1 .5 .5)
            (do ([i 1 (fx+ i 1)] [g 128 (fx+ g 1)]) ((= g 256))
              (output-color-class i 1 1 1))])
         (http:respond conn 200 '(("Content-Type" . "text/css")) (get))))]
     ))

  (http:add-server 'http (cond [(opt 'port) => string->number] [else 9002])
    (http:url-handler
     (<request> open request [method path])
     (cond
      [(and (eq? method 'GET)
            (json:ref pages (string->symbol path) #f)) =>
       (lambda (h) (http:call-url-handler h))]
      [else
       (not-found conn)]))))

